# HTTPS and www -> ulpia.bg
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://ulpia.bg%{REQUEST_URI} [L,R=301]

# Short links for social profiles and posts (tracked in Google Analytics)
RewriteRule ^fb/?$ /?utm_source=facebook&utm_medium=social [L,R=302,NE]
RewriteRule ^ig/?$ /?utm_source=instagram&utm_medium=social [L,R=302,NE]

# Cache images for a month, the page itself briefly
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType text/html "access plus 5 minutes"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
