# HTTPS and www -> ulpia.bg
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://ulpia.bg%{REQUEST_URI} [L,R=301]

# Short links for social profiles and posts (tracked in Google Analytics)
RewriteRule ^fb/?$ /?utm_source=facebook&utm_medium=social [L,R=302,NE]
RewriteRule ^ig/?$ /?utm_source=instagram&utm_medium=social [L,R=302,NE]

# Cache images for a month, the page itself briefly
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 5 minutes"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/xml text/plain
</IfModule>

AddType image/webp .webp
AddType font/woff2 .woff2

# Basic security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
